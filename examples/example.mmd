classDiagram

class Order {
  +id: string
  +total() number
}

class Customer {
  +name: string
}

class OrderStatus {
  <<enumeration>>
  Draft
  Paid
  Shipped
}

Customer "1" --> "*" Order : places
Order --> OrderStatus : status

