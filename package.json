{
  "name": "shiny-diagram",
  "displayName": "Shiny Diagram",
  "description": "Visual editor for Mermaid class diagrams with write-back to source. Built for AI-human co-creation.",
  "version": "0.0.1",
  "license": "MIT",
  "publisher": "anton-efremov",
  "repository": {
    "type": "git",
    "url": "https://github.com/anton-efremov/shiny-diagram"
  },
  "keywords": [
    "mermaid",
    "diagram",
    "class diagram",
    "uml",
    "visual editor"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:shiny.openDiagram",
    "onCustomEditor:shiny.diagram"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "shiny.openDiagram",
        "title": "Shiny: Open Diagram",
        "icon": "$(preview)"
      },
      {
        "command": "shiny.exportPng",
        "title": "Shiny: Export PNG"
      },
      {
        "command": "shiny.mark",
        "title": "Shiny: Mark"
      }
    ],
    "customEditors": [
      {
        "viewType": "shiny.diagram",
        "displayName": "Shiny Diagram",
        "selector": [
          {
            "filenamePattern": "*.mmd"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "shiny.openDiagram",
          "when": "resourceExtname == .mmd && activeCustomEditorId != shiny.diagram",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "npm run compile && npm run build:webview",
    "build:webview": "vite build",
    "compile": "tsc -p ./tsconfig.build.json",
    "debug": "vscode-custom-editor-harness",
    "typecheck": "tsc -p ./ --noEmit && tsc -p ./tsconfig.webview.json --noEmit",
    "check:boundaries": "node scripts/check-webview-boundaries.mjs",
    "check:planes": "node scripts/check-planes.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint extension-host webview/src",
    "planes": "node scripts/update-planes.mjs",
    "test": "node scripts/check-test-coverage.mjs && vitest run && vitest run --config vitest.extension.config.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:boundaries && npm run check:planes && npm run test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@types/node": "^20.14.8",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@xyflow/react": "^12.11.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "html-to-image": "^1.11.13",
    "mermaid": "^11.15.0",
    "prettier": "^3.8.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.5.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.10",
    "vscode-custom-editor-harness": "github:anton-efremov/vscode-custom-editor-harness"
  }
}
